{
  "name": "hina-raws",
  "description": "A RingCentral community app",
  "version": "0.0.14-hina-raws",
  "main": "main.js",
  "homepage": "https://github.com/hina-raws/ringcentral-community-app",
  "license": "MIT",
  "author": {
    "name": "hina-raws",
    "email": "service.relay.lab@gmail.com",
    "url": "https://github.com/hina-raws"
  },
  "scripts": {
    "start": "electron .",
    "package-linux": "electron-builder --linux -p never",
    "package-release": "electron-builder --linux -p always"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-progressbar": "^2.1.0"
  },
  "build": {
    "appId": "com.ringcentral.community",
    "productName": "RingCentral Community",
    "directories": {
      "buildResources": "icons"
    },
    "files": [
      "**/*"
    ],
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Network",
      "desktop": {
        "Exec": "env ELECTRON_ENABLE_WAYLAND=1 %U"
      }
    }
  }
}
